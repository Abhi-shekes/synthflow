DATABASE_URL=postgresql+psycopg://synthflow:synthflow@localhost:5433/synthflow
# Signs every access/refresh token and encrypts every stored connection
# credential (app.core.secrets) — generate a real one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
# "production" turns the SECRET_KEY/CORS/OIDC checks in app.core.config
# from warnings into hard failures at startup. Leave as development for a
# local, non-Docker run of this backend.
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]
